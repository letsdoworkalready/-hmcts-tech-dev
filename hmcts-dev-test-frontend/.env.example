# Local configuration. Copy to `.env` in this directory (`cp .env.example .env`).
# Values here are loaded when the server starts (see `src/main/server.ts`).

PORT=3100
API_BASE_URL=http://localhost:4000
SESSION_SECRET=hmcts-task-manager-secret-change-in-production

# Optional: in development, use HTTP instead of HTTPS (nodemon also sets this).
# DEV_USE_HTTP=true
