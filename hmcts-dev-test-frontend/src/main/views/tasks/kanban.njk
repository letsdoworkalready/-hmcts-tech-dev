{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% extends "template.njk" %}

{% block pageTitle %}Tasks - HMCTS Task Manager{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {# ── Header row ── #}
      <div class="govuk-grid-row govuk-!-margin-bottom-4">
        <div class="govuk-grid-column-one-half">
          <h1 class="govuk-heading-xl govuk-!-margin-bottom-1">Your tasks</h1>
          <p class="govuk-body app-signed-in-line">Signed in as <strong>{{ actorName }}</strong>. <form method="post" action="/sign-out" class="app-inline-sign-out-form"><button type="submit" class="govuk-link app-sign-out-button">Sign out</button></form></p>
        </div>
        <div class="govuk-grid-column-one-half app-view-toolbar">
          <div class="app-view-toggle" role="group" aria-label="Switch view">
            <a href="/tasks?view=list" class="govuk-link app-view-toggle__btn">List view</a>
            <span class="app-view-toggle__btn app-view-toggle__btn--active" aria-current="true">Kanban view</span>
          </div>
          {% if tasks.length > 0 %}
            <a href="/tasks/new" role="button" draggable="false" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">
              Create new task
            </a>
          {% endif %}
        </div>
      </div>

      {% if apiError %}
        {{ govukNotificationBanner({
          type: "important",
          titleText: "Important",
          html: '<p class="govuk-body">' + apiError + '</p>'
        }) }}
      {% endif %}

      {% if tasks.length == 0 %}
        <div class="govuk-inset-text">
          <p class="govuk-body">No tasks found. <a class="govuk-link" href="/tasks/new">Create your first task</a>.</p>
        </div>
      {% else %}

        {# ── Kanban board ── #}
        <div class="app-kanban-board" role="list">
          {% for column in columns %}
            <section
              class="app-kanban-column app-kanban-column--{{ column.id | lower | replace('_', '-') }}"
              aria-label="{{ column.label }} column ({{ column.tasks | length }} tasks)"
              role="listitem"
            >
              <div class="app-kanban-column__header">
                <h2 class="govuk-heading-s app-kanban-column__title">{{ column.label }}</h2>
                <span class="app-kanban-column__count govuk-body-s">{{ column.tasks | length }}</span>
              </div>

              {% if column.tasks | length == 0 %}
                <p class="govuk-body-s app-kanban-column__empty">No tasks here.</p>
              {% else %}
                {% for task in column.tasks %}
                  <article class="app-kanban-card">
                    <h3 class="govuk-heading-s app-kanban-card__title">{{ task.title }}</h3>
                    {% if task.description %}
                      <p class="govuk-body-s app-kanban-card__description">{{ task.description }}</p>
                    {% endif %}
                    <p class="govuk-body-s app-kanban-card__meta">
                      <span class="app-kanban-card__meta-label">Due:</span>
                      {{ task.dueDateTime | formatDueDateTime }}
                    </p>

                    <div class="app-kanban-card__actions govuk-button-group govuk-!-margin-bottom-0">
                      <a
                        href="/tasks/{{ task.id }}/edit"
                        role="button"
                        draggable="false"
                        class="govuk-button govuk-button--small"
                        data-module="govuk-button"
                      >Edit</a>
                      <button
                        type="button"
                        class="govuk-button govuk-button--secondary govuk-button--small"
                        data-module="govuk-button"
                        onclick="
                          var d = document.getElementById('delete-task-dialog');
                          document.getElementById('delete-task-dialog-title').textContent = 'Are you sure you want to delete \u201c{{ task.title | escape }}\u201d?';
                          document.getElementById('delete-task-form').action = '/tasks/{{ task.id }}/delete';
                          d.showModal();
                        "
                      >Delete</button>
                    </div>
                  </article>
                {% endfor %}
              {% endif %}
            </section>
          {% endfor %}
        </div>

      {% endif %}

    </div>
  </div>

  {# Shared delete confirmation dialog #}
  <dialog
    id="delete-task-dialog"
    class="delete-task-dialog"
    aria-labelledby="delete-task-dialog-title"
    aria-modal="true"
  >
    <div class="delete-task-dialog__panel">
      <h2 class="govuk-heading-m" id="delete-task-dialog-title">
        Are you sure you want to delete this task?
      </h2>
      <p class="govuk-body">This action cannot be undone.</p>
      <form id="delete-task-form" method="post" action="">
        <div class="govuk-button-group">
          <button type="submit" class="govuk-button app-button--modal-delete-confirm" data-module="govuk-button">
            Yes, delete task
          </button>
          <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" onclick="document.getElementById('delete-task-dialog').close()">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </dialog>

{% endblock %}
